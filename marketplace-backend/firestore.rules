rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
             && (
               (request.auth.token.email == "admin@cyclify.in"
                && request.auth.token.email_verified == true)
               || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
             );
    }

    function validAdminOrderUpdate() {
      return request.resource.data.status in [
               "Order Received",
               "Order Shipped",
               "Order Delivered"
             ]
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               "status",
               "tracking",
               "reviewableProductIds",
               "updatedAt",
               "shippedAt",
               "deliveredAt"
             ]);
    }

    function validReviewModerationUpdate() {
      return request.resource.data.status in [
               "approved",
               "rejected"
             ]
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               "status",
               "moderatedAt",
               "moderatedBy"
             ]);
    }

    match /usedListings/{listingId} {
      allow read: if resource.data.status == "approved"
                  || (signedIn() && resource.data.ownerId == request.auth.uid)
                  || isAdmin();

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.price is number
                    && request.resource.data.imageUrls.size() <= 4;

      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.ownerId == request.auth.uid
                        && resource.data.status == "pending"
                        && request.resource.data.ownerId == request.auth.uid
                        && request.resource.data.status == "pending");

      allow delete: if isAdmin()
                    || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /customers/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /orders/{orderId} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
        // Orders are created only by the trusted payment webhook backend.
        // Firebase Admin SDK writes bypass client security rules.
        allow create: if false;
        allow update: if isAdmin() && validAdminOrderUpdate();
        allow delete: if false;
      }
    }

    match /paymentAttempts/{attemptId} {
      allow read: if (signedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    match /productReviews/{productId}/reviews/{reviewId} {
      allow read: if resource.data.status == "approved"
                  || (signedIn() && resource.data.userId == request.auth.uid)
                  || isAdmin();

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.productId == productId
                    && reviewId == request.auth.uid + "__" + request.resource.data.orderId
                    && request.resource.data.status == "pending"
                    && request.resource.data.verifiedPurchase == true
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 2
                    && request.resource.data.title.size() <= 80
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() >= 10
                    && request.resource.data.comment.size() <= 1500
                    && request.resource.data.imageUrls is list
                    && request.resource.data.imageUrls.size() <= 3
                    && request.resource.data.orderId is string
                    && exists(/databases/$(database)/documents/customers/$(request.auth.uid)/orders/$(request.resource.data.orderId))
                    && get(/databases/$(database)/documents/customers/$(request.auth.uid)/orders/$(request.resource.data.orderId)).data.status == "Order Delivered"
                    && get(/databases/$(database)/documents/customers/$(request.auth.uid)/orders/$(request.resource.data.orderId)).data.reviewableProductIds is list
                    && get(/databases/$(database)/documents/customers/$(request.auth.uid)/orders/$(request.resource.data.orderId)).data.reviewableProductIds.hasAny([productId]);

      allow update: if isAdmin() && validReviewModerationUpdate();
      allow delete: if isAdmin();
    }

    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
      allow update: if isAdmin() && validAdminOrderUpdate();
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if resource.data.status == "approved"
                  || (signedIn() && resource.data.userId == request.auth.uid)
                  || isAdmin();
      allow update: if isAdmin() && validReviewModerationUpdate();
      allow delete: if isAdmin();
    }
  }
}
