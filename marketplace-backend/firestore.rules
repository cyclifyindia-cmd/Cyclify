rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
             && (
               (request.auth.token.email == "admin@cyclify.in"
                && request.auth.token.email_verified == true)
               || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
             );
    }

    match /usedListings/{listingId} {
      allow read: if resource.data.status == "approved"
                  || (signedIn() && resource.data.ownerId == request.auth.uid)
                  || isAdmin();

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.price is number
                    && request.resource.data.imageUrls.size() <= 4;

      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.ownerId == request.auth.uid
                        && resource.data.status == "pending"
                        && request.resource.data.ownerId == request.auth.uid
                        && request.resource.data.status == "pending");

      allow delete: if isAdmin()
                    || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Every customer's commerce data is isolated by their Firebase Auth UID.
    match /customers/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /orders/{orderId} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
        allow create: if signedIn()
                      && request.auth.uid == uid
                      && request.resource.data.customerId == uid
                      && request.resource.data.status == "Your order has been received";
        // Status changes must come from a trusted backend/admin integration.
        allow update, delete: if false;
      }
    }

    // Admin order dashboard uses a collection-group query across all customers.
    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
    }
  }
}


