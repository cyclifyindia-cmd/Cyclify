rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
             && (
               (request.auth.token.email == "admin@cyclify.in"
                && request.auth.token.email_verified == true)
               || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
             );
    }

    function validAdminOrderUpdate() {
      return request.resource.data.status in [
               "Order Received",
               "Order Shipped",
               "Order Delivered"
             ]
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               "status",
               "tracking",
               "updatedAt",
               "shippedAt",
               "deliveredAt"
             ]);
    }

    match /usedListings/{listingId} {
      allow read: if resource.data.status == "approved"
                  || (signedIn() && resource.data.ownerId == request.auth.uid)
                  || isAdmin();

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.price is number
                    && request.resource.data.imageUrls.size() <= 4;

      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.ownerId == request.auth.uid
                        && resource.data.status == "pending"
                        && request.resource.data.ownerId == request.auth.uid
                        && request.resource.data.status == "pending");

      allow delete: if isAdmin()
                    || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /customers/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /orders/{orderId} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
        allow create: if signedIn()
                      && request.auth.uid == uid
                      && request.resource.data.customerId == uid
                      && request.resource.data.status in [
                        "Your order has been received",
                        "Order Received"
                      ];
        allow update: if isAdmin() && validAdminOrderUpdate();
        allow delete: if false;
      }
    }

    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
      allow update: if isAdmin() && validAdminOrderUpdate();
    }
  }
}
